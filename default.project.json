{
  "name": "Miners Dreams",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ModelosMaquinas": {
        "$className": "Folder",
        "MineradoraBasica": {
          "$path": "modelos/mineradoras/assets/MineradoraBasica.rbxm"
        },
        "MineradoraCobre": {
          "$path": "modelos/mineradoras/assets/MineradoraCobre.rbxm"
        },
        "MineradoraFerro": {
          "$path": "modelos/mineradoras/assets/MineradoraFerro.rbxm"
        },
        "MineradoraIndustrial": {
          "$path": "modelos/mineradoras/assets/MineradoraIndustrial.rbxm"
        },
        "MineradoraPressurizada": {
          "$path": "modelos/mineradoras/assets/MineradoraPressurizada.rbxm"
        },
        "MineradoraCristalina": {
          "$path": "modelos/mineradoras/assets/MineradoraCristalina.rbxm"
        },
        "MineradoraRessonante": {
          "$path": "modelos/mineradoras/assets/MineradoraRessonante.rbxm"
        },
        "MineradoraPlasma": {
          "$path": "modelos/mineradoras/assets/MineradoraPlasma.rbxm"
        },
        "MineradoraAtomica": {
          "$path": "modelos/mineradoras/assets/MineradoraAtomica.rbxm"
        },
        "MineradoraQuantica": {
          "$path": "modelos/mineradoras/assets/MineradoraQuantica.rbxm"
        },
        "MineradoraSingularidade": {
          "$path": "modelos/mineradoras/assets/MineradoraSingularidade.rbxm"
        },
        "MineradoraEstelar": {
          "$path": "modelos/mineradoras/assets/MineradoraEstelar.rbxm"
        },
        "MineradoraGalactica": {
          "$path": "modelos/mineradoras/assets/MineradoraGalactica.rbxm"
        },
        "EsteiraBasica": {
          "$path": "modelos/rojo/EsteiraBasica.rbxm"
        },
        "FornalhaBasica": {
          "$path": "modelos/rojo/FornalhaBasica.rbxm"
        },
        "ModificadorBasico": {
          "$path": "modelos/rojo/ModificadorBasico.rbxm"
        }
      },
      "Packages":{
        "$path": "Packages"
      },
      "UpdateGold": {
        "$className": "RemoteEvent"
      },
      "UpdateGems": {
        "$className": "RemoteEvent"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server",
      "$ignoreUnknownInstances": true,
      "ServerPackages":{
        "$path": "ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$path": "modelos/rojo/Baseplate.rbxm"
      },
      "SpawnLocation": {
        "$path": "modelos/rojo/SpawnLocation.rbxm"
      }
    },
    "Lighting": {
      "$path": "modelos/rojo/Lighting.rbxm"
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
