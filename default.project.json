{
  "name": "Miners Dreams",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ModelosMaquinas": {
        "$className": "Folder",
        "MineradoraBasica": {
          "$path": "modelos/rojo/MineradoraBasica.rbxm"
        },
        "EsteiraBasica": {
          "$path": "modelos/rojo/EsteiraBasica.rbxm"
        },
        "FornalhaBasica": {
          "$path": "modelos/rojo/FornalhaBasica.rbxm"
        },
        "ModificadorBasico": {
          "$path": "modelos/rojo/ModificadorBasico.rbxm"
        }
      },
      "Packages":{
        "$path": "Packages"
      },
      "UpdateGold": {
        "$className": "RemoteEvent"
      },
      "UpdateGems": {
        "$className": "RemoteEvent"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server",
      "$ignoreUnknownInstances": true,
      "ServerPackages":{
        "$path": "ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$path": "modelos/rojo/Baseplate.rbxm"
      },
      "SpawnLocation": {
        "$path": "modelos/rojo/SpawnLocation.rbxm"
      }
    },
    "Lighting": {
      "$path": "modelos/rojo/Lighting.rbxm"
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
