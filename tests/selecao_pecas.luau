-- Exercita o estado real da selecao sem interface, rede ou dados persistidos.
local roblox = require("./suporte/modelos")
local carregar = require("./suporte/carregador")({ CFrame = roblox.CFrame }, {})
local SelecaoPecas = carregar("src/client/SelecaoPecas")
local selecoes = SelecaoPecas.new()
local copia = { MaquinaId = "Esteira2x2", Token = 1, Rotacao = roblox.CFrame.identity,
	Modificacoes = { Dados = { Nivel = 3 }, Configuracao = { Componentes = { { Velocidade = 13 } } } } }
local primeira = selecoes:Definir("Inventario", "Esteira2x2", roblox.CFrame.identity, copia)
assert(selecoes:Obter("Inventario") == primeira)
assert(not pcall(function() primeira.MaquinaId = "Outra" end))
assert(not pcall(function() primeira.Copia.Modificacoes.Dados.Nivel = 99 end))
assert(not pcall(function() primeira.Copia.Modificacoes.Configuracao.Componentes[1].Velocidade = 99 end))
copia.Modificacoes.Dados.Nivel = 9
assert(primeira.Copia.Modificacoes.Dados.Nivel == 3, "A entrada tambem precisa ser copiada antes de ser armazenada.")
local giro = roblox.CFrame.Angles(0, math.pi / 2, 0)
selecoes:GuardarRotacao("Inventario", primeira.Id, giro)
local girada = selecoes:Obter("Inventario")
assert(girada.Id == primeira.Id and girada.Rotacao == giro)
assert(primeira.Rotacao == roblox.CFrame.identity, "Uma consulta antiga nao pode mudar por efeito de outra operacao.")
local segunda = selecoes:Definir("Inventario", "Esteira2x2", roblox.CFrame.identity, nil)
assert(segunda.Id ~= primeira.Id)
selecoes:GuardarRotacao("Inventario", primeira.Id, giro)
assert(selecoes:Obter("Inventario") == segunda, "Uma resposta antiga nao pode alterar uma selecao nova do mesmo tipo.")
local loja = selecoes:Definir("Loja", "FornalhaBasica", roblox.CFrame.identity, nil)
selecoes:Remover("Inventario")
selecoes:GuardarRotacao("Inventario", segunda.Id, giro)
assert(not selecoes:Obter("Inventario") and selecoes:Obter("Loja") == loja)
local outroJogador = SelecaoPecas.new()
assert(not outroJogador:Obter("Loja"))
assert(not pcall(function() outroJogador:Definir("OutraAba", "FornalhaBasica", giro) end))
print("PASS: selecoes imutaveis, copia profunda, identidade estavel durante giro, isolamento e protecao contra respostas antigas.")
